{
  "name": "@basketikun/canvas-proxy",
  "version": "0.1.0",
  "description": "Minimal local forwarding proxy that lets the Infinite Canvas web app call AI provider APIs without CORS restrictions.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "bin": {
    "canvas-proxy": "index.js"
  },
  "files": [
    "index.js",
    "memory-tasks.js",
    "provider-error.js",
    "video-tasks.js",
    "task-storage.js",
    "tencent-vod.js",
    "README.md"
  ],
  "scripts": {
    "start": "node index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "tencentcloud-sdk-nodejs-common": "4.1.220"
  },
  "publishConfig": {
    "access": "public"
  }
}
